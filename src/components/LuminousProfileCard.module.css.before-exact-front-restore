/* =========================================================
   LUMINOUS PROFILE CARD
   Exact Luminous structure + profile photo + Spotify flip
========================================================= */

.shell {
  position: relative;
  width: 100%;
  max-width: 520px;
  aspect-ratio: 18 / 24;
  perspective: 1800px;
  outline: none;
}

.card {
  position: relative;

  width: 100%;
  height: 100%;

  transform-style: preserve-3d;

  transition:
    translate 0.4s ease-out;
}

.card:not(.cardFlipped):hover {
  translate: 0 -0.2rem;
}

/* =========================================================
   COMMON FACE
========================================================= */

.face {
  position: absolute;
  inset: 0;

  overflow: hidden;

  border-radius: 1.8rem;
  border: 3px solid var(--ink);

  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.front {
  background:
    radial-gradient(
      circle at 50% 0%,
      #3a3a3a 0%,
      #1a1a1a 64%
    );

  box-shadow:
    inset 0 1.01rem 0.2rem -1rem #fff0,
    inset 0 -1.01rem 0.2rem -1rem #0000,
    0 -1.02rem 0.2rem -1rem #fff0,
    0 1rem 0.2rem -1rem #0000,
    0 0 0 1px #fff3,
    0 4px 4px 0 #0004,
    0 0 0 1px #333;
}


/* =========================================================
   PROFILE PHOTO
========================================================= */

.photo {
  position: absolute;
  inset: 0;

  z-index: 0;

  overflow: hidden;

  background: #090909;
}

.photo::after {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  background:
    linear-gradient(
      180deg,
      rgba(0,0,0,.55),
      rgba(0,0,0,.1) 35%,
      rgba(0,0,0,.72) 100%
    );

  transition:
    opacity .7s ease;
}

.photo img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  /* Slightly larger than the old card */
  transform: scale(1.08);

  opacity: .16;

  filter:
    grayscale(100%)
    brightness(.22)
    contrast(1.18);

  transition:
    opacity .85s cubic-bezier(.16,1,.3,1),
    filter .85s cubic-bezier(.16,1,.3,1),
    transform 1s cubic-bezier(.16,1,.3,1);
}


/* =========================================================
   LUMINOUS LIGHT LAYER
========================================================= */

.lightLayer {
  position: absolute;
  inset: 0;

  z-index: 2;

  transform-style: preserve-3d;

  perspective: 400px;

  pointer-events: none;
}


/* =========================================================
   FLASH BAR
   MOVED TO THE BOTTOM
========================================================= */

.slit {
  position: absolute;

  left: 13%;
  right: 13%;
  bottom: 4.75rem;

  width: auto;
  height: .82rem;

  background: #101010;

  border-radius: 999px;

  box-shadow:
    0 0 5px #fff0;

  filter: blur(.15px);

  opacity: .85;

  transition:
    all .45s ease-in-out;
}


/* =========================================================
   LIGHT FIELDS
========================================================= */

.lumen {
  position: absolute;
  inset: 0;

  pointer-events: none;

  perspective: 400px;

  opacity: 0;

  transition:
    opacity .5s ease-in-out;
}

.lumen .min {
  width: 70%;
  height: 3rem;

  background:
    linear-gradient(#fff0, #fffa);

  position: absolute;

  left: 0;
  right: 0;
  top: auto;
  bottom: 1.2rem;

  margin: auto;

  transform: rotateX(-42deg);

  opacity: .4;
}

.lumen .mid {
  width: 74%;
  height: 13rem;

  background:
    linear-gradient(#fff0, #fffa);

  position: absolute;

  left: 0;
  right: 0;
  top: auto;
  bottom: -2.5rem;

  margin: auto;

  transform: rotateX(-42deg);

  filter: blur(1rem);

  opacity: .8;

  border-radius:
    100% 100% 0 0;
}

.lumen .hi {
  width: 50%;
  height: 13rem;

  background:
    linear-gradient(#fff0, #fffa);

  position: absolute;

  left: 0;
  right: 0;
  top: auto;
  bottom: -3.5rem;

  margin: auto;

  transform: rotateX(22deg);

  filter: blur(1rem);

  opacity: .6;

  border-radius:
    100% 100% 0 0;
}


/* =========================================================
   DARKEN
========================================================= */

.darken {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  pointer-events: none;

  perspective: 400px;

  transition:
    opacity .4s ease-in-out;

  opacity: .5;
}

.darken > * {
  transition:
    opacity .4s ease-in-out;
}

.darken .sl {
  width: 64%;
  height: 10rem;

  background:
    linear-gradient(#000, #0000);

  position: absolute;

  left: 0;
  right: 0;
  top: 9.6em;
  bottom: 0;

  margin: auto;

  filter: blur(.2rem);

  opacity: .1;

  border-radius:
    0 0 100% 100%;

  transform: rotateX(-22deg);
}

.darken .ll {
  width: 62%;
  height: 10rem;

  background:
    linear-gradient(#000a, #0000);

  position: absolute;

  left: 0;
  right: 0;
  top: 11em;
  bottom: 0;

  margin: auto;

  filter: blur(.8rem);

  opacity: .4;

  border-radius:
    0 0 100% 100%;

  transform: rotateX(22deg);
}

.darken .slt {
  width: .5rem;
  height: 4rem;

  background:
    linear-gradient(#0005, #0000);

  position: absolute;

  left: 0;
  right: 11.5rem;
  top: 3.9em;
  bottom: 0;

  margin: auto;

  opacity: .6;

  border-radius:
    0 0 100% 100%;

  transform: skewY(42deg);
}

.darken .srt {
  width: .5rem;
  height: 4rem;

  background:
    linear-gradient(#0005, #0000);

  position: absolute;

  right: 0;
  left: 11.5rem;
  top: 3.9em;
  bottom: 0;

  margin: auto;

  opacity: .6;

  border-radius:
    0 0 100% 100%;

  transform: skewY(-42deg);
}


/* =========================================================
   CONTENT
========================================================= */

.content {
  position: relative;

  z-index: 4;

  width: 100%;
  height: 100%;

  display: flex;
  flex-direction: column;
  justify-content: flex-end;

  padding: 1rem;

  color: #fff;
}

.bottom {
  position: relative;

  display: flex;
  flex-direction: column;

  gap: .7rem;
}

.title {
  margin: 0;
  margin-bottom: .2rem;

  font-size: 1.2rem;

  color: #fff;

  font-weight: 500;

  letter-spacing: -.02em;

  text-shadow:
    0 2px 12px rgba(0,0,0,.45);
}

.description {
  margin: 0;

  padding-bottom: .55rem;

  color: #aaa;

  font-size: .6rem;

  font-weight: 100;

  border-bottom: 1px solid #fff1;

  max-width: 64%;
}


/* =========================================================
   OFFICIAL SPOTIFY EMBED
========================================================= */

.spotifyMini {
  position: relative;

  width: 100%;
  height: 152px;

  overflow: hidden;

  border-radius: 12px;

  background: #191414;

  box-shadow:
    0 10px 28px rgba(0, 0, 0, .28),
    inset 0 1px 0 rgba(255,255,255,.06);

  pointer-events: auto;

  z-index: 20;
}

.spotifyMini iframe {
  display: block;

  width: 100%;
  height: 152px;

  border: 0;

  border-radius: 12px;
}

.playerFallback {
  width: 100%;
  height: 100%;

  display: grid;
  place-items: center;

  color: rgba(255,255,255,.65);

  font-family: var(--font-mono);
  font-size: .55rem;
}

/* =========================================================
   LUMEN TOGGLE
========================================================= */

.luminousToggle {
  position: relative;

  align-self: flex-end;

  display: flex;
  align-items: center;

  gap: .5rem;

  min-height: 32px;

  padding: .2rem .45rem .2rem .25rem;

  border: 0;
  border-radius: .65rem;

  background: #000;

  box-shadow:
    inset 0 -8px 8px 0.3rem #0004,
    inset 0 0 1px 0.3rem #ddd,
    inset 0 -2px 1px 0.3rem #fff,
    inset 0 1px 2px 0.3rem #0006,
    inset 0 0 1px 0.8rem #aaa;

  color: #999;

  cursor: pointer;
}

.luminousToggleRail {
  position: relative;

  width: 54px;
  height: 11px;

  border-radius: .2rem;

  background: #000;

  box-shadow:
    inset 0 0 4px rgba(255,255,255,.12);
}

.luminousHandle {
  position: absolute;

  top: -2px;
  left: 6px;

  width: 21px;
  height: 15px;

  border-radius: .2rem;

  background: #aaa;

  box-shadow:
    inset 0 1px 4px 0 #fff,
    inset 0 -1px 1px 0 #000a,
    0 0 1px 1px #0003,
    1px 3px 6px 1px #000a;

  transition:
    transform .4s cubic-bezier(.34,1.56,.64,1),
    box-shadow .4s ease;
}

.luminousToggleLabel {
  white-space: nowrap;

  font-family: var(--font-mono);

  font-size: .43rem;

  font-weight: 700;

  letter-spacing: .08em;
}


/* =========================================================
   LUMEN ON
========================================================= */

.lumenOn .photo img {
  opacity: .96;

  filter:
    grayscale(100%)
    brightness(.92)
    contrast(1.1);

  transform: scale(1.095);
}

.lumenOn .photo::after {
  opacity: .17;
}

.lumenOn .front {
  box-shadow:
    inset 0 1.01rem .1rem -1rem #fffa,
    inset 0 -4rem 3rem -3rem #000a,
    0 -1.02rem .2rem -1rem #fffa,
    0 1rem .2rem -1rem #000,
    0 0 0 1px #fff2,
    0 4px 4px 0 #0004,
    0 0 0 1px #333;
}

.lumenOn .slit {
  background: #fff;

  box-shadow:
    0 0 5px 1px #fff,
    0 0 22px rgba(255,255,255,.55);

  animation:
    bottomFlash 1s cubic-bezier(.16,1,.3,1);
}

.lumenOn .lumen {
  opacity: .62;
}

.lumenOn .darken {
  opacity: .82;
}

.lumenOn .darken .sl {
  opacity: .18;
}

.lumenOn .darken .ll {
  opacity: 1;
}

.lumenOn .darken .slt {
  opacity: 1;
}

.lumenOn .darken .srt {
  opacity: 1;
}

.lumenOn .luminousHandle {
  transform: translateX(32px);

  box-shadow:
    inset 0 1px 12px 0 #fff,
    inset 0 -1px 1px 0 #fffa,
    0 0 2px 1px #4443,
    1px 3px 6px 1px #0004;
}

.lumenOn .luminousToggleRail::after {
  content: "";

  position: absolute;
  inset: -3px;

  border-radius: .3rem;

  box-shadow:
    0 0 10px 2px rgba(255,255,255,.55);

  pointer-events: none;
}


/* =========================================================
   FLASH ANIMATION
========================================================= */

@keyframes bottomFlash {
  0% {
    opacity: .15;
    transform: scaleX(.35);
  }

  35% {
    opacity: 1;
    transform: scaleX(1.08);
  }

  100% {
    opacity: .9;
    transform: scaleX(1);
  }
}


/* =========================================================
   FOCUS
========================================================= */

.shell:focus-visible {
  outline:
    3px solid
    var(--mustard);

  outline-offset: 7px;

  border-radius: 2rem;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {
  .shell {
    width: min(100%, 420px);
  }

  .content {
    padding: .85rem;
  }

  .title {
    font-size: 1.1rem;
  }

  .description {
    font-size: .55rem;
  }

  .spotifyMini {
    min-height: 44px;
  }

  .spotifyInfo strong {
    font-size: .54rem;
  }

  .spotifyInfo span {
    font-size: .39rem;
  }

  .luminousToggleLabel {
    font-size: .4rem;
  }
}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .card,
  .photo img,
  .photo::after,
  .lumen,
  .darken,
  .slit,
  .luminousHandle {
    transition: none !important;
  }

  .lumenOn .slit {
    animation: none !important;
  }

  .musicDot span {
    animation: none !important;
  }
}
