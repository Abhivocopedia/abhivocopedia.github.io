.footer {
  position: relative;
  background: var(--ink);
  color: var(--warm-white);
  padding: var(--space-4xl) 0 var(--space-2xl);
  border-top: 4px solid var(--mustard);
  overflow: hidden;
}

.bgDecoration {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.container {
  position: relative;
  z-index: 1;
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 var(--container-padding);
}

.main {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-2xl);
  margin-bottom: var(--space-2xl);
  padding-bottom: var(--space-2xl);
  border-bottom: 2px solid rgba(255, 253, 246, 0.1);
}

@media (min-width: 769px) {
  .main {
    grid-template-columns: minmax(0, 1fr) minmax(360px, 1.7fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(18px, 2vw, 34px);
  }
}

.brand {
  max-width: 350px;
}

.logo {
  display: block;
  font-family: var(--font-display);
  font-size: 1.75rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--mustard);
  margin-bottom: var(--space-md);
}

.tagline {
  font-family: var(--font-body);
  font-size: 1rem;
  color: rgba(255, 253, 246, 0.7);
  line-height: 1.7;
  margin-bottom: var(--space-lg);
}

.brandAccent {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  opacity: 0.6;
}

.genesisPreview {
  min-width: 0;
  width: 100%;
  align-self: stretch;
}

.genesisPreviewHeader {
  display: flex;
  align-items: center;
  gap: 10px;
  height: 34px;
  padding: 0 12px;
  border: 1px solid rgba(255, 253, 246, 0.14);
  border-bottom: 0;
  background: rgba(255, 253, 246, 0.045);
  border-radius: 12px 12px 0 0;
}

.genesisPreviewDots {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  flex-shrink: 0;
}

.genesisPreviewDots i {
  width: 7px;
  height: 7px;
  border-radius: 999px;
  display: block;
  background: rgba(255, 253, 246, 0.32);
}

.genesisPreviewTitle {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--font-mono);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: rgba(255, 253, 246, 0.72);
}

.genesisPreviewOpen {
  margin-left: auto;
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--mustard);
  text-decoration: none;
}

.genesisPreviewOpen:hover {
  color: var(--warm-white);
}

.genesisPreviewFrame {
  position: relative;
  width: 100%;
  height: clamp(180px, 18vw, 235px);
  overflow: hidden;
  border: 1px solid rgba(255, 253, 246, 0.14);
  border-radius: 0 0 12px 12px;
  background: #050505;
  box-shadow:
    0 16px 35px rgba(0, 0, 0, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.03);
}

.genesisPreviewIframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
  background: #050505;
}

@media (max-width: 768px) {
  .genesisPreview {
    width: 100%;
  }

  .genesisPreviewFrame {
    height: 210px;
  }
}

/* =========================================================
   GITHUB // LIVE — CYBERPUNK HUD
========================================================= */

.githubLive {
  position: relative;
  display: block;
  width: 100%;
  min-height: 158px;
  padding: 13px 14px 11px;
  overflow: hidden;
  color: #eaffff;
  text-decoration: none;
  background:
    linear-gradient(
      145deg,
      rgba(9, 20, 28, 0.98),
      rgba(3, 8, 13, 0.98)
    );
  border: 1px solid rgba(48, 224, 255, 0.38);
  box-shadow:
    inset 0 0 24px rgba(0, 215, 255, 0.035),
    0 0 18px rgba(0, 216, 255, 0.08);
  clip-path: polygon(
    0 8px,
    8px 0,
    100% 0,
    100% calc(100% - 8px),
    calc(100% - 8px) 100%,
    0 100%
  );
  transition:
    transform 160ms ease,
    border-color 160ms ease,
    box-shadow 160ms ease;
}

.githubLive:hover {
  transform: translateY(-2px);
  border-color: rgba(48, 224, 255, 0.8);
  box-shadow:
    inset 0 0 26px rgba(0, 215, 255, 0.05),
    0 0 24px rgba(0, 216, 255, 0.16);
}

.githubLiveGlow {
  position: absolute;
  top: -45px;
  right: -35px;
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background: rgba(0, 229, 255, 0.08);
  filter: blur(24px);
  pointer-events: none;
}

.githubLiveTop {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.githubLiveHeading {
  display: flex;
  align-items: center;
  gap: 7px;
  font-family: var(--font-mono);
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #d7fbff;
}

.githubLivePrompt {
  color: #21e6ff;
  font-size: 0.48rem;
  opacity: 0.7;
}

.githubLiveOnline {
  display: flex;
  align-items: center;
  gap: 5px;
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 0.46rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: rgba(220, 255, 242, 0.58);
}

.githubLiveOnline > span {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #52ff97;
  box-shadow:
    0 0 5px #52ff97,
    0 0 10px rgba(82, 255, 151, 0.7);
  animation: githubLiveBlink 1.6s ease-in-out infinite;
}

.githubLiveRule {
  position: relative;
  z-index: 1;
  height: 1px;
  margin: 9px 0 11px;
  background:
    linear-gradient(
      90deg,
      rgba(34, 224, 255, 0.55),
      rgba(34, 224, 255, 0.08),
      transparent
    );
}

.githubLiveStats {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
}

.githubLiveStat {
  min-width: 0;
  padding: 7px 6px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(48, 224, 255, 0.1);
}

.githubLiveLabel {
  display: block;
  margin-bottom: 4px;
  font-family: var(--font-mono);
  font-size: 0.4rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  color: rgba(215, 251, 255, 0.42);
}

.githubLiveStat strong {
  display: block;
  font-family: var(--font-mono);
  font-size: 1.02rem;
  line-height: 1;
  font-weight: 800;
  letter-spacing: -0.04em;
  color: #f0ffff;
  text-shadow:
    0 0 8px rgba(48, 224, 255, 0.3);
}

.githubLiveGraph {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
  margin-top: 9px;
}

.githubLiveGraphRow {
  display: grid;
  grid-template-columns: 16px 1fr;
  align-items: center;
  gap: 5px;
}

.githubLiveGraphRow > span {
  font-family: var(--font-mono);
  font-size: 0.38rem;
  color: rgba(215, 251, 255, 0.28);
}

.githubLiveGraphTrack {
  height: 3px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.05);
}

.githubLiveGraphTrack i {
  display: block;
  height: 100%;
  background:
    linear-gradient(
      90deg,
      #16d9ff,
      #2fffd0 70%,
      #9c6bff
    );
  box-shadow:
    0 0 8px rgba(22, 217, 255, 0.45);
  transition: width 500ms ease;
}

.githubLiveBottom {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  gap: 7px;
  margin-top: 9px;
  font-family: var(--font-mono);
  font-size: 0.37rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: rgba(215, 251, 255, 0.3);
}

.githubLiveBottom span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@keyframes githubLiveBlink {
  0%, 100% {
    opacity: 0.55;
  }

  50% {
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .githubLiveOnline > span {
    animation: none;
  }
}

@media (max-width: 768px) {
  .githubLive {
    min-height: 150px;
  }

  .githubLiveBottom {
    flex-direction: column;
    gap: 3px;
  }
}

.vexr {
  text-align: right;
}

@media (max-width: 768px) {
  .vexr {
    text-align: left;
  }
}

.vexrLabel {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--mustard);
  margin-bottom: var(--space-lg);
}

.vexrLines {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  align-items: flex-end;
}

@media (max-width: 768px) {
  .vexrLines {
    align-items: flex-start;
  }
}

.vexrLine {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--warm-white);
  white-space: nowrap;
}

.vexrStar {
  flex-shrink: 0;
  animation: starPulse 2s ease-in-out infinite;
}

.vexrLine:nth-child(1) .vexrStar { animation-delay: 0s; }
.vexrLine:nth-child(2) .vexrStar { animation-delay: 0.3s; }
.vexrLine:nth-child(3) .vexrStar { animation-delay: 0.6s; }

@keyframes starPulse {
  0%, 100% { transform: scale(1); opacity: 0.7; }
  50% { transform: scale(1.2); opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .vexrStar {
    animation: none;
  }
}

.divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,253,246,0.1), transparent);
  margin-bottom: var(--space-xl);
}

.bottom {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-lg);
  text-align: center;
}

@media (min-width: 769px) {
  .bottom {
    flex-direction: row;
    justify-content: space-between;
    text-align: left;
  }
}

.copyright p {
  font-family: var(--font-body);
  font-size: 0.875rem;
  color: rgba(255, 253, 246, 0.5);
}

.footerLinks {
  display: flex;
  gap: var(--space-md);
}

.footerLinks a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(255, 253, 246, 0.08);
  color: rgba(255, 253, 246, 0.7);
  border: 2px solid transparent;
  transition: all var(--transition-base);
}

.footerLinks a:hover {
  background: var(--mustard);
  color: var(--ink);
  border-color: var(--mustard);
  transform: translateY(-3px);
  box-shadow: var(--shadow-lg);
}

.footerLinks a:focus-visible {
  outline: 3px solid var(--mustard);
  outline-offset: 3px;
}

@media (max-width: 768px) {
  .footer {
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .main {
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .logo {
    font-size: 1.5rem;
  }

  .vexrLine {
    font-size: 1.125rem;
  }

  .footerLinks a {
    width: 44px;
    height: 44px;
  }
}

/* =========================================================
   THANKS TO — TOOL MARQUEE
========================================================= */

.toolMarqueeSection {
  width: 100%;
  margin-bottom: clamp(28px, 4vw, 46px);
  padding-top: clamp(16px, 2vw, 24px);
  border-top: 1px solid rgba(23, 23, 23, 0.16);
}

.toolMarqueeLabel {
  display: block;
  margin-bottom: 12px;
  text-align: center;
  font-family: var(--font-mono);
  font-size: 0.55rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  color: rgba(23, 23, 23, 0.58);
}

.toolMarqueeViewport {
  width: 100%;
  overflow: hidden;
  mask-image: linear-gradient(
    90deg,
    transparent,
    #000 5%,
    #000 95%,
    transparent
  );
  -webkit-mask-image: linear-gradient(
    90deg,
    transparent,
    #000 5%,
    #000 95%,
    transparent
  );
}

.toolMarqueeTrack {
  width: max-content;
  display: flex;
  align-items: center;
  gap: 12px;
  animation: footerToolMarquee 34s linear infinite;
  will-change: transform;
}

.toolMarqueeItem {
  min-width: 142px;
  height: 48px;
  padding: 0 13px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  border: 1px solid rgba(23, 23, 23, 0.12);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.62);
  color: var(--ink);
  text-decoration: none;
  white-space: nowrap;
  box-shadow:
    0 6px 18px rgba(23, 23, 23, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease;
}

.toolMarqueeItem:hover {
  transform: translateY(-3px);
  border-color: rgba(23, 23, 23, 0.24);
  box-shadow:
    0 10px 22px rgba(23, 23, 23, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.toolMarqueeItem img {
  display: block;
  width: 24px;
  height: 24px;
  min-width: 24px;
  min-height: 24px;
  object-fit: contain;
  object-position: center;
  flex-shrink: 0;
  opacity: 1;
  visibility: visible;
  filter: none !important;
}

.toolMarqueeItem span {
  font-family: var(--font-mono);
  font-size: 0.55rem;
  font-weight: 700;
  letter-spacing: 0.07em;
}

@keyframes footerToolMarquee {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(calc(-50% - 6px));
  }
}

@media (prefers-reduced-motion: reduce) {
  .toolMarqueeTrack {
    animation: none;
  }
}

@media (max-width: 768px) {
  .toolMarqueeItem {
    min-width: 128px;
    height: 44px;
  }

  .toolMarqueeItem img {
    width: 21px;
    height: 21px;
    flex-basis: 21px;
  }
}


/* --- EDGE TO EDGE THANKS TO TICKER --- */

.toolMarqueeSection {
  position: relative;
  width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  margin-top: 0;
  margin-bottom: clamp(2.5rem, 5vw, 5rem);
  padding: 14px 0;
  background: #000;
  border-top: 1px solid rgba(255, 255, 255, 0.18);
  border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  overflow: hidden;
  border-radius: 0;
}

.toolMarqueeLabel {
  position: absolute;
  z-index: 3;
  left: 20px;
  top: 50%;
  transform: translateY(-50%);
  margin: 0;
  padding: 0;
  white-space: nowrap;
  background: #000;
  color: #fff;
  font-family: var(--font-mono);
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.toolMarqueeViewport {
  width: 100%;
  overflow: hidden;
  padding-left: 118px;
  padding-right: 20px;
  mask-image: linear-gradient(
    90deg,
    transparent 0,
    #000 3%,
    #000 97%,
    transparent 100%
  );
  -webkit-mask-image: linear-gradient(
    90deg,
    transparent 0,
    #000 3%,
    #000 97%,
    transparent 100%
  );
}

.toolMarqueeTrack {
  width: max-content;
  display: flex;
  align-items: center;
  gap: 0;
  animation: footerToolMarquee 34s linear infinite;
  will-change: transform;
}

.toolMarqueeItem {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
  height: 34px;
  padding: 0 18px 0 10px;
  flex-shrink: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: rgba(255, 255, 255, 0.86);
  text-decoration: none;
  white-space: nowrap;
  transition: color 180ms ease, transform 180ms ease;
}

.toolMarqueeItem::after {
  content: "•";
  position: absolute;
  right: 1px;
  top: 50%;
  transform: translateY(-50%);
  color: rgba(255, 255, 255, 0.35);
  font-size: 0.8rem;
  pointer-events: none;
}

.toolMarqueeItem:hover {
  color: #fff;
  transform: translateY(-1px);
}

.toolMarqueeItem img {
  width: 21px;
  height: 21px;
  object-fit: contain;
  flex-shrink: 0;
  filter: none;
  opacity: 1;
}

.toolMarqueeItem span {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.03em;
}

@media (max-width: 700px) {
  .toolMarqueeSection {
    padding: 12px 0;
    margin-bottom: 3rem;
  }

  .toolMarqueeLabel {
    left: 12px;
    font-size: 0.58rem;
    letter-spacing: 0.11em;
  }

  .toolMarqueeViewport {
    padding-left: 92px;
    padding-right: 10px;
  }

  .toolMarqueeItem {
    padding-left: 8px;
    padding-right: 16px;
    gap: 7px;
  }

  .toolMarqueeItem img {
    width: 19px;
    height: 19px;
  }

  .toolMarqueeItem span {
    font-size: 0.62rem;
  }
}
