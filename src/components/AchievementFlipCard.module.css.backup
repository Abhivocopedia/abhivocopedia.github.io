.cardWrapper {
  display: block;
  width: 100%;
  max-width: 980px;
  margin: 0 auto;
}

.card {
  position: relative;
  width: 100%;
  height: 520px;
  perspective: 1200px;
  cursor: pointer;
  border-radius: var(--radius-xl);
  outline: none;
}

.cardInner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
  border-radius: var(--radius-xl);
}

.cardFace {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.cardFace[data-side='front'] {
  background: var(--ink);
  color: var(--warm-white);
  border: 3px solid var(--ink);
  box-shadow:
    0 24px 48px rgba(0, 0, 0, 0.2),
    0 0 0 1px rgba(224, 174, 62, 0.2) inset;
}

.cardFace[data-side='back'] {
  background: var(--ink);
  color: var(--warm-white);
  border: 3px solid var(--ink);
  transform: rotateY(180deg);
}

.card:focus-visible {
  outline: 4px solid var(--mustard);
  outline-offset: 5px;
}

.cardFront {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: var(--space-2xl);
  overflow: hidden;
}

.cardFront::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(
    var(--mustard) 1px,
    transparent 1px
  );
  background-size: 30px 30px;
  opacity: 0.025;
  pointer-events: none;
}

.cardFront::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6px;
  background: linear-gradient(
    90deg,
    var(--orange),
    var(--mustard),
    var(--deep-green),
    var(--teal)
  );
}

.frontTop {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-lg);
  margin-bottom: var(--space-xl);
  position: relative;
  z-index: 1;
}

.awardBadge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92px;
  height: 92px;
  background: rgba(224, 174, 62, 0.15);
  border: 3px solid var(--mustard);
  border-radius: var(--radius-lg);
  color: var(--mustard);
  flex-shrink: 0;
}

.awardRibbon {
  writing-mode: vertical-rl;
  text-orientation: mixed;
  flex-shrink: 0;
}

.awardRibbon span {
  font-family: var(--font-display);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--mustard);
  background: rgba(224, 174, 62, 0.15);
  padding: var(--space-lg) var(--space-sm);
  border-radius: var(--radius-md);
  border: 2px solid var(--mustard);
  min-height: 110px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.awardContent {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.awardEvent {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--mustard);
  margin-bottom: var(--space-md);
}

.awardTitle {
  margin: 0;
  font-family: var(--font-display);
  font-size: clamp(2.1rem, 5vw, 3.4rem);
  font-weight: 700;
  line-height: 1.02;
  letter-spacing: -0.03em;
  color: var(--warm-white);
}

.awardDetails {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-lg);
  margin-top: auto;
  padding-top: var(--space-xl);
  border-top: 1px solid rgba(255, 253, 246, 0.1);
}

.awardDetail {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  min-width: 0;
}

.detailValue {
  font-family: var(--font-body);
  font-size: 0.92rem;
  font-weight: 500;
  line-height: 1.45;
  color: var(--warm-white);
  overflow-wrap: anywhere;
}

.flipPrompt {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
  margin-top: var(--space-xl);
  padding-top: var(--space-md);
  border-top: 1px solid rgba(255, 253, 246, 0.1);
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--mustard);
}

.cardBack {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--ink);
}

.backImageWrapper {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.backImage {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
}

.photoPlaceholder {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  background: linear-gradient(
    135deg,
    var(--ink),
    var(--deep-green)
  );
}

.placeholderContent {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  color: var(--warm-white);
  text-align: center;
}

.imageOverlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  padding: var(--space-2xl);
  background: linear-gradient(
    180deg,
    rgba(23, 23, 23, 0) 35%,
    rgba(23, 23, 23, 0.42) 62%,
    rgba(23, 23, 23, 0.94) 100%
  );
  pointer-events: none;
}

.overlayContent {
  width: 100%;
}

@media (max-width: 768px) {
  .card {
    height: 430px;
  }

  .cardFront {
    padding: var(--space-xl);
  }

  .awardBadge {
    width: 72px;
    height: 72px;
  }

  .awardTitle {
    font-size: clamp(1.7rem, 8vw, 2.4rem);
  }

  .awardDetails {
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .detailValue {
    font-size: 0.82rem;
  }

  .imageOverlay {
    padding: var(--space-xl);
  }
}

@media (prefers-reduced-motion: reduce) {
  .cardInner {
    transition: none;
  }
